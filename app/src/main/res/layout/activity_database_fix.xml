<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1C1B1B"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Database Fix Utility"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:text="Add approval system to existing users"
            android:textColor="#CCCCCC"
            android:textSize="14sp"
            android:gravity="center" />

        <!-- Fix Database Button -->
        <Button
            android:id="@+id/btn_fix_database"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:background="#FF6B35"
            android:text="Fix Database"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Verify Fix Button -->
        <Button
            android:id="@+id/btn_verify_fix"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="24dp"
            android:background="#4CAF50"
            android:text="Verify Fix"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Status Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="#2C2C2C"
            android:orientation="vertical"
            android:padding="4dp">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:padding="16dp"
                android:background="#1E1E1E">

                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ready to fix database..."
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="4dp" />

            </ScrollView>

        </LinearLayout>

        <!-- Instructions -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Instructions:\n\n1. Click 'Fix Database' to add approval system fields to existing users\n\n2. All existing users will be set to 'approved' status\n\n3. New registrations will require admin approval\n\n4. Use 'Verify Fix' to check results"
            android:textColor="#CCCCCC"
            android:textSize="12sp"
            android:padding="12dp"
            android:background="#33FFA726"
            android:lineSpacingExtra="2dp" />

    </LinearLayout>

</ScrollView>