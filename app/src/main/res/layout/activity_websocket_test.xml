<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1C1B1B"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="WebSocket Server Test"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- Status -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ready to connect..."
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="@drawable/rectangle_curved_screen6"
        android:backgroundTint="#2D2D2D"
        android:padding="12dp"
        android:layout_marginBottom="16dp" />

    <!-- Connection Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btn_connect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Connect"
            android:textColor="#FFFFFF"
            android:background="@drawable/rectangle_curved_screen6"
            android:backgroundTint="#4CAF50"
            android:layout_marginEnd="8dp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_disconnect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Disconnect"
            android:textColor="#FFFFFF"
            android:background="@drawable/rectangle_curved_screen6"
            android:backgroundTint="#F44336"
            android:layout_marginStart="8dp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Message Input -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Send Message"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <EditText
            android:id="@+id/et_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Type your message..."
            android:textColorHint="#AAAAAA"
            android:textColor="#FFFFFF"
            android:background="@drawable/rectangle_curved_screen6"
            android:backgroundTint="#2D2D2D"
            android:padding="12dp"
            android:layout_marginEnd="8dp"
            android:maxLines="3" />

        <Button
            android:id="@+id/btn_send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Send"
            android:textColor="#FFFFFF"
            android:background="@drawable/rectangle_curved_screen6"
            android:backgroundTint="#077CE9"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Messages Log -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Messages Log"
            android:textColor="#AAAAAA"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clear"
            android:textColor="#FFFFFF"
            android:background="@drawable/rectangle_curved_screen6"
            android:backgroundTint="#666666"
            android:textSize="12sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/tv_messages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Messages will appear here..."
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:background="@drawable/rectangle_curved_screen6"
            android:backgroundTint="#2D2D2D"
            android:padding="12dp"
            android:fontFamily="monospace"
            android:lineSpacingMultiplier="1.2" />

    </ScrollView>

    <!-- Instructions -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Instructions: Start WebSocket server (start_websocket_server.bat), then click Connect to test real-time messaging."
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        android:layout_marginTop="8dp"
        android:gravity="center" />

</LinearLayout>